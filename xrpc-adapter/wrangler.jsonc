{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koke-xrpc-adapter",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "4da88288dc30d9ee257f319d3c33ecf0",
  "workers_dev": false,
  "vars": {
    "ACTOR_DID": "did:web:koke.itonami.cloud",
    "PDS_URL": "https://pds.itonami.cloud",
    "L2_RPC_URL": "https://mainnet.base.org"
  },
  "routes": [{"pattern": "koke.itonami.cloud/xrpc/*", "zone_name": "itonami.cloud"}],
  "observability": {"enabled": true}
}
